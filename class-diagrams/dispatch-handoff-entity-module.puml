@startuml DispatchHandoffEntityModule
allowmixing
title 封发交接模块核心实体关系图

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam roundcorner 8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.5

skinparam package {
  BorderColor #455A64
  FontColor #263238
  FontSize 16
}

skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontColor #263238
  FontSize 14
}

skinparam component {
  BackgroundColor #F1F8E9
  BorderColor #689F38
  FontColor #263238
  FontSize 14
}

package "封发交接模块\nliana-dispatch-service" as dispatch {
  class "DispatchBagEntity\n总包/邮袋" as DispatchBagEntity {
    bagNo
    mailCount
    totalWeightGrams
    originFacilityCode
    destFacilityCode
    routeCode
    status
  }

  class "DispatchBatchEntity\n封发批次" as DispatchBatchEntity {
    batchNo
    bagNo
    status
  }

  class "HandoffRecordEntity\n交接记录" as HandoffRecordEntity {
    bagNo
    handoverFacilityCode
    receiverFacilityCode
    status
  }

  class "RouteRuleEntity\n封发路由规则" as RouteRuleEntity {
    routeCode
    originScope
    destScope
    status
  }
}

component "OMS 邮件服务\nOMS Service" as oms
component "分拣服务\nSorting Service" as sorting
component "运输服务\nTransport Service" as transport
component "轨迹服务\nTracking Service" as tracking

RouteRuleEntity "1" -- "0..*" DispatchBagEntity : routeCode
DispatchBagEntity "1" -- "0..*" DispatchBatchEntity : bagNo
DispatchBagEntity "1" -- "0..*" HandoffRecordEntity : bagNo

oms --> dispatch : 同步邮件入包数据
dispatch --> sorting : 提供封发路单
dispatch --> transport : 总包衔接运输任务
dispatch --> tracking : 记录封发和交接事件

note bottom of DispatchBagEntity
总包是单件邮件进入跨网点、
跨运输环节前的聚合单位。
end note

note bottom of DispatchBatchEntity
支撑总包生成、批次审批、
交接确认和运输衔接流程。
end note

@enduml

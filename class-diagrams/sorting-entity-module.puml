@startuml SortingEntityModule
allowmixing
title 分拣作业模块核心实体关系图

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam roundcorner 8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.5

skinparam package {
  BorderColor #455A64
  FontColor #263238
  FontSize 16
}

skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontColor #263238
  FontSize 14
}

skinparam component {
  BackgroundColor #F1F8E9
  BorderColor #689F38
  FontColor #263238
  FontSize 14
}

package "分拣作业模块\nliana-sorting-service" as sorting {
  class "SortingManifestEntity\n路单/预报单" as SortingManifestEntity {
    manifestNo
    manifestType
    sourceOrgCode
    destinationOrgCode
    expectedPackageQty
    expectedItemQty
    manifestStatus
    prealertFlag
    etaTime
    checkedFlag
  }

  class "SortingManifestItemEntity\n路单明细" as SortingManifestItemEntity {
    manifestNo
    packageNo
    itemNo
    waybillNo
  }

  class "PackageItemLineEntity\n分拣扫描流水" as PackageItemLineEntity {
    manifestNo
    packageNo
    itemNo
    waybillNo
    eventType
    slotCode
    stationCode
    eventTime
  }

  class "DiscrepancyVerificationEntity\n差异核验记录" as DiscrepancyVerificationEntity {
    manifestNo
    packageNo
    itemNo
    discrepancyType
    source
    expectedQty
    actualQty
    status
  }
}

component "封发服务\nDispatch Service" as dispatch
component "OMS 邮件服务\nOMS Service" as oms
component "轨迹服务\nTracking Service" as tracking

SortingManifestEntity "1" -- "0..*" SortingManifestItemEntity : manifestNo
SortingManifestEntity "1" -- "0..*" PackageItemLineEntity : manifestNo
SortingManifestEntity "1" -- "0..*" DiscrepancyVerificationEntity : manifestNo

dispatch --> sorting : 同步封发路单
sorting --> oms : 更新邮件状态、格口和目的节点
sorting --> tracking : 写入接收、开拆、分拣事件

note bottom of SortingManifestEntity
围绕路单执行接收、开拆、
差异核验和后续落格处理。
end note

note bottom of DiscrepancyVerificationEntity
记录少件、多件、安检失败等异常，
为后续稽核和人工处理提供依据。
end note

@enduml

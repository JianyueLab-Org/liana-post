@startuml FacilityEntityModule
allowmixing
title 设施基础数据模块核心实体关系图

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam roundcorner 8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.5

skinparam package {
  BorderColor #455A64
  FontColor #263238
  FontSize 16
}

skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontColor #263238
  FontSize 14
}

skinparam component {
  BackgroundColor #F1F8E9
  BorderColor #689F38
  FontColor #263238
  FontSize 14
}

package "设施基础数据模块\nliana-facility-service" as facility {
  class "FacilityEntity\n网点设施" as FacilityEntity {
    facilityCode
    facilityName
    facilityTypeCode
    parentFacilityCode
    enabled
  }

  class "FacilityRouteEntity\n设施路由关系" as FacilityRouteEntity {
    routeCode
    originFacilityCode
    destFacilityCode
    transportMode
    enabled
  }

  class "FacilityTypeEntity\n设施类型字典" as FacilityTypeEntity {
    facilityTypeCode
    facilityTypeName
    enabled
  }
}

component "OMS 邮件服务\nOMS Service" as oms
component "分拣服务\nSorting Service" as sorting
component "封发服务\nDispatch Service" as dispatch
component "运输服务\nTransport Service" as transport
component "轨迹服务\nTracking Service" as tracking

FacilityTypeEntity "1" -- "0..*" FacilityEntity : facilityTypeCode
FacilityEntity "1" -- "0..*" FacilityRouteEntity : originFacilityCode
FacilityEntity "1" -- "0..*" FacilityRouteEntity : destFacilityCode

facility --> oms : 提供机构编码和节点名称
facility --> sorting : 提供分拣中心与目的节点
facility --> dispatch : 提供封发路由基础信息
facility --> transport : 提供运输起讫节点
facility --> tracking : 提供轨迹节点展示信息

note bottom of FacilityEntity
设施数据是跨服务协作的主数据来源，
覆盖邮局、转运中心和国际交换局等节点。
end note

@enduml

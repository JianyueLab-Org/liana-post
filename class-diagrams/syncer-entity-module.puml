@startuml SyncerEntityModule
allowmixing
title 离线同步模块核心实体关系图

left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam roundcorner 8
skinparam ArrowColor #263238
skinparam ArrowThickness 1.5

skinparam package {
  BorderColor #455A64
  FontColor #263238
  FontSize 16
}

skinparam class {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
  FontColor #263238
  FontSize 14
}

skinparam component {
  BackgroundColor #F1F8E9
  BorderColor #689F38
  FontColor #263238
  FontSize 14
}

package "离线同步模块\nliana-syncer" as syncer {
  class "OutboxMessageEntity\n待同步事件" as OutboxMessageEntity {
    msgId
    eventType
    payload
    sourceService
    targetService
    status
  }

  class "SyncTaskEntity\n同步任务" as SyncTaskEntity {
    taskNo
    sourceService
    targetService
    status
    retryCount
    maxRetries
  }

  class "RetryRecordEntity\n失败重试记录" as RetryRecordEntity {
    taskNo
    retryCount
    nextRetryTime
    lastError
    status
  }
}

component "业务服务\nOMS / Sorting / Dispatch" as biz
component "定时任务入口\nScheduler" as scheduler
component "目标服务\nTarget Service" as target

OutboxMessageEntity "1" -- "0..*" SyncTaskEntity : msgId
SyncTaskEntity "1" -- "0..*" RetryRecordEntity : taskNo

biz --> syncer : 写入待同步事件
scheduler --> syncer : 扫描任务并触发重试
syncer --> target : 预留事件投递与补偿能力

note bottom of syncer
当前实现定位为离线同步与最终一致性的架构预留模块，
已具备表结构、实体映射、定时任务入口和重试策略骨架。
end note

@enduml

FROM eclipse-temurin:17-jre AS backend
WORKDIR /app
ARG MODULE
COPY ${MODULE}.jar /app/app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

FROM eclipse-temurin:17-jre AS database
WORKDIR /app
COPY liana-database.jar /app/database.jar
COPY lib /app/lib
ENTRYPOINT ["java", "-cp", "/app/database.jar:/app/lib/*", "com.liana.post.database.DatabaseManager"]

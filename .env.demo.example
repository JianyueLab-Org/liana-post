# Copy to .env.demo, then set four independent local demo credentials.
LIANA_DB_PASSWORD=replace-with-local-db-password
LIANA_DEMO_PASSWORD=replace-with-local-login-password
LIANA_PACKING_TOKEN=replace-with-random-packing-token
LIANA_MANIFEST_TOKEN=replace-with-random-manifest-token
# Named volumes are new and independent of the retired mysql_data/redis_data.
LIANA_MYSQL_PORT=3307
LIANA_WEB_PORT=80
SENTINEL_HOME=D:/sentinel
